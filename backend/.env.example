# Google AI Studio > API keys 에서 발급 (https://aistudio.google.com/apikey)
GEMINI_API_KEY=

# 필요할 때만 변경 (기본값 그대로 사용 권장)
GEMINI_IMAGE_MODEL=gemini-2.5-flash-image
GEMINI_TTS_MODEL=gemini-2.5-flash-preview-tts

# 생성된 이미지·오디오·영상이 저장되는 경로 (git에 커밋되지 않음)
STORAGE_DIR=./storage

# 프런트엔드(Vite dev server) 출처. 콤마로 여러 개 지정 가능
CORS_ORIGINS=http://localhost:5173
